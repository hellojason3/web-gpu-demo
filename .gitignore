# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo lock file (optional - include if you want reproducible builds)
# Cargo.lock

# wasm-pack build output
/pkg/
/wasm-pack.log

# Node modules (if using npm/yarn for any tooling)
/node_modules/
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*

# Python cache (from the dev server)
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build scripts temporary files
/build/
/dist/
/out/

# Log files
*.log

# Environment files
.env
.env.local
.env.*.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Backup files
*.bak
*.backup
*.tmp
*.temp

# Coverage and test reports
/coverage/
*.lcov
.nyc_output/

# Documentation build output
/docs/_build/
/docs/.doctrees/

# Temporary serve.py if generated by build script
serve.py
